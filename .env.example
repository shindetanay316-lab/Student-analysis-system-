# Required before deployment; the fallback is only for local development.
SECRET_KEY=replace-with-a-long-random-secret

# Leave DATABASE_URL unset to use instance/student_analysis.db (SQLite).
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:password@localhost/ece_sms
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost/ece_sms

CURRENT_ACADEMIC_YEAR=2025-26
CURRENT_SEMESTER=6
MAX_UPLOAD_MB=25

# Used only when seed.py creates these users for the first time.
ADMIN_PASSWORD=admin123
TEACHER_PASSWORD=teacher123

# Optional folder overrides.
# UPLOAD_FOLDER=/absolute/path/to/uploads
# REPORTS_FOLDER=/absolute/path/to/reports
# RESULT_DATA_UPLOAD_FOLDER=/absolute/path/to/result-pdf-uploads

# Optional report signatories.
CLASS_TEACHER_NAME=Prof. A. V. Khake
HOD_NAME=Dr. D. L. Bhuyar

# Enable only during local debugging.
FLASK_DEBUG=0
